            VALUE "OriginalFilename", "Sorinuri.exe"
            VALUE "ProductName",      "Sorinuri"
            VALUE "ProductVersion",   "6.3.9.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 0x04B0
    END
END
